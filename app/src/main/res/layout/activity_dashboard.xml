<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#CFD8DC">

    <LinearLayout
        android:id="@+id/cardUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_dashboard"
        android:padding="12dp"
        android:elevation="6dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#1A237E"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="usuario@correo.com"
            android:textSize="14sp"
            android:textColor="#000000"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_settings_gear"
        android:background="@android:color/transparent"
        android:padding="0dp"
        android:scaleType="fitCenter"
        app:tint="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvBienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel de Control"
        android:textColor="#000000"
        android:textSize="26sp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cardUsuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <LinearLayout
        android:id="@+id/cardCandado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_dashboard"
        android:padding="32dp"
        android:elevation="12dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvBienvenido"
        app:layout_constraintBottom_toTopOf="@id/btnAbrir"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">

    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_lock_closed"
        app:tint="#1A237E"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CERRADO"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        android:textColor="#1A237E"/>

</LinearLayout>

<Button
    android:id="@+id/btnAbrir"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:text="ABRIR CERRADURA"
    android:textSize="18sp"
    android:fontFamily="sans-serif-medium"
    android:backgroundTint="#2ECC71"
    android:textColor="#FFFFFF"
    app:cornerRadius="16dp"
    android:layout_marginBottom="16dp"
    app:layout_constraintBottom_toTopOf="@id/btnCerrar"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

<Button
    android:id="@+id/btnCerrar"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:text="CERRAR CERRADURA"
    android:textSize="18sp"
    android:fontFamily="sans-serif-medium"
    android:backgroundTint="#E74C3C"
    android:textColor="#FFFFFF"
    app:cornerRadius="16dp"
    android:layout_marginBottom="32dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>